{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* Specs may read from the filesystem (e.g. checking that hero photos exist),
       so they need Node types that the browser build deliberately omits. */
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}